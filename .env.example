# Copy this file to .env and adjust as needed.
# docker-compose.yml and the Python services read these via os.environ.

# --- MinIO / S3 ---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=socialsphere

# --- Ingestion service ---
BRONZE_PREFIX=bronze/events
BUFFER_FLUSH_SIZE=500
BUFFER_FLUSH_INTERVAL_SECONDS=10

# --- Dashboard ---
GOLD_DATA_ROOT=./data/gold_local

# --- Event generator ---
EVENT_OUTPUT_DIR=./data/bronze_local
